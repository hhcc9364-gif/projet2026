<Window x:Class="SandraGestion.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SANDRA GESTION - ERP &amp; Comptabilité Tunisienne | Développé par Radhwen Ennaceur" 
        Height="850" Width="1350"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NavyDarkBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header Bar -->
            <RowDefinition Height="64" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Footer Credit Bar -->
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- TOP BAR (El Djem Navy & Gold) -->
        <Border Grid.Row="0" Background="{StaticResource NavySurfaceBrush}" BorderBrush="{StaticResource NavyBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="8" Background="{StaticResource GoldPrimaryBrush}" Margin="0,0,12,0">
                        <TextBlock Text="SG" FontWeight="Bold" FontSize="18" Foreground="#070D1D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SANDRA GESTION" FontWeight="Bold" FontSize="16" Foreground="{StaticResource GoldPrimaryBrush}" />
                        <TextBlock Text="ERP &amp; COMPTABILITÉ TUNISIENNE" FontSize="10" Foreground="{StaticResource TextMutedBrush}" LetterSpacing="1" />
                    </StackPanel>
                </StackPanel>

                <!-- DUAL SESSION SWITCHER (Center) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#060C1A" CornerRadius="20" Padding="4" BorderBrush="{StaticResource NavyBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbSessionFinanciere" GroupName="SessionGroup" IsChecked="True" Style="{x:Null}" Padding="16,6" Margin="2" Cursor="Hand" Click="OnSessionChanged">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#3B82F6" Margin="0,0,8,0" />
                                            <TextBlock Text="Session Financière (Légale SCE)" FontWeight="SemiBold" FontSize="12" Foreground="#E2E8F0" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#1E3A8A" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>

                        <RadioButton x:Name="RbSessionReelle" GroupName="SessionGroup" Style="{x:Null}" Padding="16,6" Margin="2" Cursor="Hand" Click="OnSessionChanged">
                            <RadioButton.Template>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="border" Background="Transparent" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" />
                                            <TextBlock Text="Session Réelle (Usine &amp; Coûts)" FontWeight="SemiBold" FontSize="12" Foreground="#E2E8F0" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#064E3B" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </RadioButton.Template>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- USER, TENANT & LANGUAGE (Right) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="CmbLanguage" Width="90" Height="30" Margin="0,0,12,0" Background="#060C1A" Foreground="#F8FAFC" BorderBrush="{StaticResource NavyBorderBrush}" SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem Content="Français" IsSelected="True" />
                        <ComboBoxItem Content="العربية" />
                    </ComboBox>

                    <Border Background="#132347" CornerRadius="6" Padding="10,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Usine Sfax (Mat. 1234567/A/M/000)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldLightBrush}" />
                        </StackPanel>
                    </Border>

                    <Button Content="Sauvegarder BD" Style="{StaticResource GoldButtonStyle}" Padding="10,6" FontSize="11" Click="OnBackupClicked" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Navigation Sidebar -->
                <ColumnDefinition Width="240" />
                <!-- Dynamic Content View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource NavySurfaceBrush}" BorderBrush="{StaticResource NavyBorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,16">
                    <Button Content="📊 Tableau de bord" Style="{StaticResource GoldButtonStyle}" Margin="0,4" HorizontalContentAlignment="Left" />
                    <Button Content="🧾 Factures &amp; Ventes" Background="Transparent" Foreground="#CBD5E1" FontWeight="Medium" Margin="0,4" Padding="14,8" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand" />
                    <Button Content="🏭 Usine &amp; Production" Background="Transparent" Foreground="#CBD5E1" FontWeight="Medium" Margin="0,4" Padding="14,8" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand" />
                    <Button Content="📚 Comptabilité SCE" Background="Transparent" Foreground="#CBD5E1" FontWeight="Medium" Margin="0,4" Padding="14,8" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand" />
                    <Button Content="📦 Stocks &amp; Matières" Background="Transparent" Foreground="#CBD5E1" FontWeight="Medium" Margin="0,4" Padding="14,8" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand" />
                    <Button Content="🏦 Trésorerie &amp; Banques" Background="Transparent" Foreground="#CBD5E1" FontWeight="Medium" Margin="0,4" Padding="14,8" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand" />
                    <Button Content="👥 Tiers (Clients/Fourn.)" Background="Transparent" Foreground="#CBD5E1" FontWeight="Medium" Margin="0,4" Padding="14,8" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand" />
                    <Separator Margin="0,16" Background="{StaticResource NavyBorderBrush}" />
                    <Button Content="🛡️ Administration Usines" Background="Transparent" Foreground="#F59E0B" FontWeight="SemiBold" Margin="0,4" Padding="14,8" HorizontalContentAlignment="Left" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Border>

            <!-- DASHBOARD OVERVIEW (Default View) -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24">
                    <!-- Session Banner -->
                    <Border x:Name="SessionBanner" Background="#1E3A8A" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="TxtSessionTitle" Text="SESSION FINANCIÈRE ACTIVE (CADRE LÉGAL &amp; SCE)" FontWeight="Bold" FontSize="14" Foreground="#93C5FD" />
                                <TextBlock Text="Conforme aux déclarations fiscales tunisiennes, TVA (19%, 7%, 13%), Timbre 1.000 DT et Retenue à la source." FontSize="12" Foreground="#E2E8F0" Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#0C4A6E" CornerRadius="4" Padding="8,4">
                                <TextBlock Text="Dinar Tunisien (TND)" FontWeight="Bold" Foreground="#38BDF8" FontSize="11" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI Cards -->
                    <UniformGrid Columns="4" Margin="0,0,0,24">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="Chiffre d'Affaires HT" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="185 450,250 TND" FontSize="20" FontWeight="Bold" Foreground="{StaticResource GoldPrimaryBrush}" Margin="0,6,0,0" />
                                <TextBlock Text="+14.2% vs M-1" FontSize="10" Foreground="#10B981" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="TVA Collectée (19%/7%/13%)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="32 180,450 TND" FontSize="20" FontWeight="Bold" Foreground="#60A5FA" Margin="0,6,0,0" />
                                <TextBlock Text="Timbre fiscal: 142,000 TND" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="6,0">
                            <StackPanel>
                                <TextBlock Text="Valeur Stock Réel (PMP)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="94 200,800 TND" FontSize="20" FontWeight="Bold" Foreground="#34D399" Margin="0,6,0,0" />
                                <TextBlock Text="Matières Premières: 65%" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Trésorerie Disponible (Banques + Caisse)" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="48 930,120 TND" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,0" />
                                <TextBlock Text="BIAT + Caisse Centrale" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Recent Invoices & Production Orders Summary -->
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <TextBlock Text="Opérations Récentes de l'Usine &amp; Facturation" FontWeight="Bold" FontSize="14" Foreground="#F8FAFC" Margin="0,0,0,12" />
                            <TextBlock Text="Le système local-first assure le travail hors-ligne continu sur les sites de production tunisiens." FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Background="#050A17" BorderBrush="{StaticResource NavyBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <TextBlock Text="SANDRA GESTION V1.0.0 (Windows Native Edition) • Système ERP &amp; Comptabilité Tunisienne" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GoldPrimaryBrush}">
                    <Run Text="Développé par " />
                    <Run Text="Radhwen Ennaceur" FontWeight="Bold" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
