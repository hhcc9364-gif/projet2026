<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- El Djem Amphitheatre inspired Navy & Gold Palette -->
    <!-- Developed by Radhwen Ennaceur -->
    <Color x:Key="NavyDarkColor">#070D1D</Color>
    <Color x:Key="NavySurfaceColor">#0D1B36</Color>
    <Color x:Key="NavyBorderColor">#1B315A</Color>
    <Color x:Key="GoldPrimaryColor">#C59B27</Color>
    <Color x:Key="GoldHoverColor">#DFC268</Color>
    <Color x:Key="GoldLightColor">#F3E5AB</Color>

    <!-- Session Colors -->
    <Color x:Key="SessionFinanciereColor">#3B82F6</Color> <!-- Blue Nuit Fiscal -->
    <Color x:Key="SessionReelleColor">#10B981</Color>     <!-- Green Emerald Usine -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="NavyDarkBrush" Color="{StaticResource NavyDarkColor}" />
    <SolidColorBrush x:Key="NavySurfaceBrush" Color="{StaticResource NavySurfaceColor}" />
    <SolidColorBrush x:Key="NavyBorderBrush" Color="{StaticResource NavyBorderColor}" />
    <SolidColorBrush x:Key="GoldPrimaryBrush" Color="{StaticResource GoldPrimaryColor}" />
    <SolidColorBrush x:Key="GoldHoverBrush" Color="{StaticResource GoldHoverColor}" />
    <SolidColorBrush x:Key="TextWhiteBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <!-- Button Primary Gold Style -->
    <Style x:Key="GoldButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource GoldPrimaryBrush}" />
        <Setter Property="Foreground" Value="#070D1D" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="6" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource GoldHoverBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card Container Style -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource NavySurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NavyBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
    </Style>

</ResourceDictionary>
